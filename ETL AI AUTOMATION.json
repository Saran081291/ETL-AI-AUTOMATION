    {
      "parameters": {
        "jsCode": "// Get all incoming items\nconst cleanedData = items.map(item => {\n  \n  // Parse the JSON string\n  const student = JSON.parse(item.json.text);\n\n  // Email validation\n  const emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n\n  // Course standardization\n  let course = (student.Course || \"\").trim().toLowerCase();\n\n  const courseMap = {\n    \"python\": \"Python\",\n    \"machine learning\": \"Machine Learning\",\n    \"data science\": \"Data Science\"\n  };\n\n  course = courseMap[course] || student.Course;\n\n  // Email cleaning\n  const email =\n    student.Email &&\n    student.Email !== \"INVALID_EMAIL\" &&\n    emailRegex.test(student.Email)\n      ? student.Email.toLowerCase()\n      : null;\n\n  // Phone cleaning\n  const phone =\n    student.Phone &&\n    student.Phone !== \"MISSING\" &&\n    /^\\d{10}$/.test(student.Phone)\n      ? student.Phone\n      : null;\n\n  // City cleaning\n  const city =\n    student.City &&\n    student.City !== \"UNKNOWN\"\n      ? student.City.trim()\n      : null;\n\n  // Build validation issues\n  const issues = [];\n\n  if (!email) issues.push(\"Invalid Email\");\n  if (!phone) issues.push(\"Missing/Invalid Phone\");\n  if (!city) issues.push(\"Missing City\");\n\n  return {\n    json: {\n      Student_ID: student.Student_ID,\n      Name: student.Name?.trim(),\n      Email: email,\n      Phone: phone,\n      Course: course,\n      Fee_Paid: student.Fee_Paid,\n      City: city,\n      Enrolled_Date: student.Enrolled_Date,\n\n      Record_Status:\n        issues.length === 0 ? \"Valid\" : \"Needs Review\",\n\n      Validation_Issues:\n        issues.length > 0 ? issues.join(\", \") : \"None\"\n    }\n  };\n});\n\nreturn cleanedData;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        816,
